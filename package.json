{
  "name": "@valdola/sol-lab",
  "version": "0.1.0",
  "description": "Sol's autonomous engineering lab — a minimal TypeScript CLI sandbox",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "health-check": "tsx scripts/health-check.ts",
    "health-check:run": "tsx scripts/health-check-runner.ts",
    "health-check:validate-slack": "tsx scripts/validate-slack.ts",
    "reaper:run": "tsx scripts/reaper-runner.ts",
    "reaper:sim": "tsx scripts/reaper-sim.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
