# API Health Check Configuration

# ── Alerting ───────────────────────────────────────────────────────────────
# Primary alert channel is the ValAdrien OS board (no external secret needed):
# on failure the check opens/updates a critical issue and auto-resolves it on
# recovery. Configure the OS credentials the runner uses:
VALADRIEN_OS_API_URL=https://os.valadrien.dev
VALADRIEN_OS_API_KEY=          # agent API key (long-lived; NOT a per-run JWT)
VALADRIEN_OS_COMPANY_ID=

# Optional: file alert issues under a project, and @mention on-call.
HEALTH_ALERT_PROJECT_ID=
HEALTH_ALERT_ONCALL_AGENT_ID=
HEALTH_ALERT_ONCALL_NAME=

# Optional additional channel: Slack. If SLACK_WEBHOOK_URL is set, alerts are
# ALSO posted to #eng-alerts. Leave blank to use the OS board only.
# Get this from Slack workspace admin or a secrets store.
# Format: https://hooks.slack.com/services/T.../B.../...
SLACK_WEBHOOK_URL=

# ── Check tuning (optional; defaults shown) ──────────────────────────────────
# In-cycle retries ride out a transient blip WITHIN a single check.
# HEALTH_URL=https://os.valadrien.dev/api/health
# HEALTH_TIMEOUT_MS=3000
# HEALTH_RETRY_COUNT=3
# HEALTH_RETRY_DELAY_MS=5000

# ── Circuit breaker (optional; defaults shown) — VAL-96 ──────────────────────
# Governs escalation ACROSS cycles so a sustained outage is paged once and then
# throttled (exponential backoff), instead of writing to the board — and waking
# an automation run — every 60s. See README "Failure isolation & circuit breaker".
# HEALTH_CB_FAILURE_THRESHOLD=2          # consecutive failing cycles before opening
# HEALTH_CB_NOTIFY_BASE_MS=300000        # base backoff between notifications (5 min)
# HEALTH_CB_NOTIFY_MAX_MS=1800000        # cap on the exponential backoff (30 min)
# HEALTH_CB_STATE_DIR=                   # per-endpoint state dir (default: system temp)
